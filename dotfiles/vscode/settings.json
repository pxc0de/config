{
  "editor.fontSize": 30,
  "editor.fontFamily": "'SF Mono', Monaco, 'Inconsolata', 'Roboto Mono', monospace",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.wordWrap": "on",
  "editor.minimap.enabled": false,
  "editor.lineNumbers": "on",
  "editor.rulers": [
    80,
    120
  ],
  "editor.renderWhitespace": "boundary",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "workbench.colorTheme": "Default Dark+",
  "workbench.iconTheme": "vs-seti",
  "workbench.startupEditor": "newUntitledFile",
  "workbench.editor.enablePreview": false,
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontFamily": "'SF Mono', Monaco, 'Inconsolata', 'Roboto Mono', monospace",
  "git.autofetch": true,
  "git.confirmSync": false,
  "extensions.autoUpdate": false,
  "telemetry.telemetryLevel": "off",
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "vscode-neovim.neovimInitVimPaths.darwin": "~/.config/vscode/init.lua",
  "vscode-neovim.neovimInitVimPaths.linux": "~/.config/vscode/init.lua",
  "vscode-neovim.compositeKeys": {
    "jk": {
      "command": "vscode-neovim.escape"
    }
  }
}

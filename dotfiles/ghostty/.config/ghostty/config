# Colors — Catppuccin Mocha
background = #1e1e2e
foreground = #cad3f5
background-opacity = 0.92
background-blur = true

# Palette (complete Catppuccin Mocha — without this, colors fall back to OS defaults)
palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#cba6f7
palette = 6=#94e2d5
palette = 7=#bac2de
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#cba6f7
palette = 14=#94e2d5
palette = 15=#a6adc8

# Selection
selection-background = #cba6f7
selection-foreground = #1e1e2e

# Typography
font-family = JetBrains Mono Nerd Font
font-size = 14
font-feature = "+liga"
font-feature = "+calt"
adjust-cell-height = 20%

# Cursor
cursor-style = bar
cursor-style-blink = false
cursor-color = #cba6f7

# Window
window-theme = auto
macos-titlebar-style = hidden
window-padding-x = 16
window-padding-y = 12
window-padding-balance = true

# Interaction
clipboard-read = allow
clipboard-write = allow
copy-on-select = false
mouse-hide-while-typing = true

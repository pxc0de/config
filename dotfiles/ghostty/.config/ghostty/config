# Colors
background = #1e1e2e
background-opacity = 0.75
background-blur = true
foreground = #cad3f5

# Typography
font-family = JetBrains Mono Nerd Font
font-size = 16
font-feature = "+liga"

# Cursor
cursor-style = block
adjust-cursor-thickness = 4

# Window
window-theme = auto
macos-titlebar-style = hidden
window-padding-x = 10
window-padding-y = 10

# Interaction
clipboard-read = allow
clipboard-write = allow
copy-on-select = false
